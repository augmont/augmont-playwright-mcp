{
  "name": "lgd-playwright-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright test runner with live MCP browser view for LGD Portal",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev -p 3100",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' next build",
    "start": "NODE_OPTIONS='--max-old-space-size=4096' next start -p 3100",
    "lint": "next lint",
    "playwright:install": "playwright install chromium",
    "jmeter:install": "bash scripts/install-jmeter.sh",
    "appium:drivers": "APPIUM_HOME=$PWD/.appium npx appium driver install xcuitest || true; APPIUM_HOME=$PWD/.appium npx appium driver install uiautomator2 || true",
    "appium": "APPIUM_HOME=$PWD/.appium npx appium --address 127.0.0.1 --port 4723",
    "setup": "npm install && npm run playwright:install && npm run jmeter:install && npm run appium:drivers",
    "postinstall": "npm run appium:drivers"
  },
  "dependencies": {
    "appium": "^3.5.2",
    "next": "^15.3.4",
    "pdfkit": "^0.19.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0",
    "webdriverio": "^9.29.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "playwright": "^1.53.0",
    "typescript": "^5.8.3"
  }
}
