# Optional: default portal URL shown on the setup page
NEXT_PUBLIC_DEFAULT_BASE_URL=http://localhost:4200

# Optional: default LGD backend API (location / countries)
NEXT_PUBLIC_DEFAULT_API_URL=http://localhost:3000/api/v1

# OpenRouter — required for prompt generate + non-JSON upload parsing
# Also used after each test run to write elaborate pass/fail report summaries + code snippets
OPENROUTER_API_KEY=
# Default model (or "auto" to try free models in order)
# OPENROUTER_MODEL=auto
# NEXT_PUBLIC_OPENROUTER_MODEL=auto
# Optional: preferred model for report summaries only (defaults to auto / free chain)
# OPENROUTER_REPORT_MODEL=openrouter/free
# OPENROUTER_REPORT_MAX_TOKENS=2200
# Free chain (Jul 2026): openrouter/free | qwen/qwen3-coder:free |
# poolside/laguna-m.1:free | cohere/north-mini-code:free | openai/gpt-oss-20b:free
# Note: openai/gpt-oss-120b:free is no longer free (paid only).
# OPENROUTER_SITE_URL=http://localhost:3100
# OPENROUTER_SITE_TITLE=LGD Playwright MCP
# OPENROUTER_MAX_TOKENS=2500

# Claude / Anthropic — optional alternate AI provider (UI: OpenRouter | Claude + enable/disable)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# Console API keys work best; sk-ant-oat01 OAuth tokens may need Bearer auth (already supported)
# AI_PROVIDER=openrouter
# NEXT_PUBLIC_AI_PROVIDER=openrouter
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_MAX_TOKENS=4096

# Web load (JMeter CLI) — optional if tools/apache-jmeter-* or PATH jmeter exists
# JMETER_HOME=
# JMETER_BIN=
# JMETER_VERSION=5.6.3
# On Mac: brew install openjdk && npm run jmeter:install
# Add to ~/.zshrc: export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"

# Role credentials are set in the app header (Set credentials).
# Stored in browser sessionStorage only — cleared when the tab closes.
# Do not put passwords in .env for local runs.

# AI keys: prefer header → AI setup (sessionStorage, re-enter after tab close).
# OPENROUTER_API_KEY / ANTHROPIC_API_KEY in .env are optional fallbacks only.
